		"sources": {
			"contracts/types/Employee.sol": {
				"content": "//  SPDX-License-Identifier: MIT\r\n\r\npragma solidity ^0.8.3;\r\n\r\n\r\nstruct FreelancerProfile{\r\n    uint256 id;\r\n    string name;\r\n    address wallet;\r\n    uint256 yearsOfExperience;\r\n    bool isAvail;\r\n    uint256 hourlyPaymentInWei;\r\n}\r\n\r\nstruct EmployerProfile{\r\n    uint256 id;\r\n    string name;\r\n    bool isHiring;\r\n    address wallet;\r\n    JobListings[] jobLists;\r\n}\r\n\r\nstruct CreateJobListiningProfile{\r\n    string title;\r\n    string job_description;\r\n    uint256 deadline;\r\n    uint256 fixed_pricein_wei;\r\n}\r\n\r\nstruct JobListings{\r\n    uint256 id;\r\n    string title;\r\n    string description;\r\n    uint256 deadlineTimestamp;\r\n    bool isOpentoWork;\r\n    uint256 fixedPriceInWei;\r\n    uint256 hiredFreelancerId;\r\n    bool hasHiredFreelancer;\r\n    bool isPaid;\r\n}"
			}
		}
	},
